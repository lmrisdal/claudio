{
  "name": "claudio-electron",
  "version": "0.1.9",
  "private": true,
  "description": "Claudio desktop client",
  "author": "Claudio",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "vp pack",
    "start": "electron .",
    "dev": "vp pack && electron .",
    "package": "vp pack && electron-builder",
