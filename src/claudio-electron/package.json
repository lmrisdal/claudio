    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.15",
    "vite-plus": "0.1.15"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.1.15",
      "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.15"
    }
  }
}
