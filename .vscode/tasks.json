{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/claudio-api/Claudio.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build web",
      "type": "process",
      "command": "${workspaceFolder}/src/claudio-web/node_modules/.bin/vp",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/claudio-web"
      }
    },
    {
      "label": "build api with spa",
      "dependsOn": [
        "build web",
        "build api"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/claudio-api/Claudio.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "${workspaceFolder}/src/claudio-api/Claudio.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build core",
      "type": "process",
      "command": "cargo",
      "args": ["build", "-p", "claudio-core", "--bin", "claudio-core"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "build core (C#)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/claudio-core/Claudio.Core.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "fetch 7-zip",
      "type": "shell",
      "command": "test -x artifacts/7-zip/7zzs || node scripts/fetch-7zip.mjs linux artifacts/7-zip",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build core (C#) with 7-zip",
      "dependsOn": ["fetch 7-zip", "build core (C#)"],
      "dependsOrder": "sequence"
    },
    {
      "label": "build desktop web",
      "type": "process",
      "command": "${workspaceFolder}/src/claudio-web/node_modules/.bin/vp",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/src/claudio-web",
        "env": {
          "CLAUDIO_DESKTOP_BUILD": "1"
        }
      }
    },
    {
      "label": "build electron",
      "type": "process",
      "command": "${workspaceFolder}/src/claudio-electron/node_modules/.bin/vp",
      "args": ["pack"],
      "options": {
        "cwd": "${workspaceFolder}/src/claudio-electron"
      }
    },
    {
      "label": "build desktop",
      "dependsOn": [
        "build core",
        "build desktop web",
        "build electron"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "build desktop (C# core)",
      "dependsOn": [
        "build core (C#) with 7-zip",
        "build desktop web",
        "build electron"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "electron dev",
      "type": "shell",
      "command": "./node_modules/.bin/electron .",
      "dependsOn": ["build desktop"],
      "options": {
        "cwd": "${workspaceFolder}/src/claudio-electron"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "API + Electron",
      "dependsOn": [
        "watch",
        "electron dev"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
