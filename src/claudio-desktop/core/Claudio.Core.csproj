<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>claudio-core</AssemblyName>
    <RootNamespace>Claudio.Core</RootNamespace>
    <Version>0.2.2</Version>
    <PublishAot>true</PublishAot>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../../artifacts/claudio-core/$([System.String]::Copy('$(Configuration)').ToLowerInvariant())/</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StaticOpenSslLinking)' == 'true'">
    <DefineConstants>$(DefineConstants);STATIC_OPENSSL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Claudio.Core.Tests" />
  </ItemGroup>

  <Target Name="CopySidecarCompanions" AfterTargets="Build" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <SevenZipFiles Include="$(MSBuildThisFileDirectory)../../../artifacts/7-zip/**" />
      <UninstallerFiles Include="$(MSBuildThisFileDirectory)../../../artifacts/claudio-uninstaller/$([System.String]::Copy('$(Configuration)').ToLowerInvariant())/claudio-game-uninstaller.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(SevenZipFiles)" DestinationFiles="@(SevenZipFiles->'$(OutputPath)7-zip/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(SevenZipFiles)' != ''" />
    <Copy SourceFiles="@(UninstallerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(UninstallerFiles.FullPath)')" />
  </Target>

  <Target Name="CopySidecarCompanionsToPublish" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <PublishSevenZipFiles Include="$(MSBuildThisFileDirectory)../../../artifacts/7-zip/**" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishSevenZipFiles)" DestinationFiles="@(PublishSevenZipFiles->'$(PublishDir)7-zip/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(PublishSevenZipFiles)' != ''" />
  </Target>

</Project>
